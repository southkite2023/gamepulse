# Copy to .env locally. Never commit real credentials.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CALLBACK_TOKEN=
WECHAT_ACCOUNT_ID=
WECHAT_TEST_OPEN_ID=
WECHAT_TEMPLATE_ID=
GAMEPULSE_PUBLISHER_TOKEN=
GAMEPULSE_RECEIVER_TOKEN=
# Windows visual console: use an existing authenticated SSH tunnel during development.
GAMEPULSE_RELAY_URL=http://127.0.0.1:18788
GAMEPULSE_CONSOLE_PORT=8790
